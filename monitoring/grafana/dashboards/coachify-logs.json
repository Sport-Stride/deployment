{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Log monitoring dashboard for all 10 Coachify backend services. Powered by Loki + Promtail. Complements the Prometheus metrics dashboard.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["coachify"],
      "targetBlank": true,
      "title": "Coachify Overview",
      "tooltip": "Switch to Prometheus metrics dashboard",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "description": "Real-time log stream across all selected services. Filter by level using Loki label filters. Use the Service variable above to isolate a single API.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "{job=\"coachify-backend-apis\", service=~\"$service\"}",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Live Logs — All Services",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "description": "Number of ERROR log lines per service over time. A spike indicates an issue — drill down using the Live Logs panel above.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "errors/interval",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({job=\"coachify-backend-apis\", level=\"error\", service=~\"$service\"}[$__interval]))",
          "legendFormat": "{{service}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error Rate Over Time (by service)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "description": "HTTP 500+ responses extracted from JSON logs. Complements the Prometheus gin_requests_total metric — useful when Prometheus scraping is down.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "5xx/interval",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 60,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({job=\"coachify-backend-apis\", service=~\"$service\"} | json | status >= `500` [$__interval]))",
          "legendFormat": "{{service}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx Count Over Time (by service)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "description": "Distribution of HTTP status codes per service for the selected time range. Healthy services should show predominantly 2xx.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 4,
      "options": {
        "barRadius": 0,
        "barWidth": 0.97,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "auto",
        "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "desc" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 200
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "sum by (service, status) (count_over_time({job=\"coachify-backend-apis\", service=~\"$service\"} | json [$__auto]))",
          "legendFormat": "{{service}} — {{status}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "HTTP Status Distribution (by service)",
      "type": "barchart"
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "description": "Total error count per service in the last 24 hours. Use as a daily health KPI in standups.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({job=\"coachify-backend-apis\", level=\"error\"}[24h]))",
          "legendFormat": "{{service}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Total Errors — Last 24h (by service)",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "description": "Dedicated error log panel for payments-api (tier=critical). Threshold for alerting is >2 errors/5m (vs >10 for other services). Check this first during any payment-related incident.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 26 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "{job=\"coachify-backend-apis\", service=\"coachify-payments-api\", level=\"error\"}",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Payments API — Error Logs",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "description": "Any log line containing 'panic' or 'fatal' across all selected services. This panel should always be empty in a healthy state. A Go panic that reaches this panel means Gin's recovery middleware caught it — the request failed with 500.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 26 },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-ds" },
          "editorMode": "code",
          "expr": "{job=\"coachify-backend-apis\", service=~\"$service\"} |~ \"(?i)(panic|fatal)\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Panic / Fatal Events",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["coachify", "logs", "loki"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": { "type": "loki", "uid": "loki-ds" },
        "definition": "label_values(service)",
        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values(service)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Coachify — Backend Logs",
  "uid": "coachify-logs-v1",
  "version": 1
}
