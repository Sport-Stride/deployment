# Image Versions Configuration
# This file tracks the Docker image versions for all services
# Updated automatically by GitHub Actions deploy workflow on each service build
# Format: SERVICE_NAME_VERSION=commit-sha or latest
# Last Updated: $(date)

# Microservices Versions (Updated by CI/CD on each build)
ACCOUNT_API_VERSION=latest
CHAT_API_VERSION=c1d5744af5b30685d6cd8cdaa8c3c8c2636c513e
CONTENT_API_VERSION=latest
IDENTIFIER_API_VERSION=latest
INVITATION_API_VERSION=latest
NOTIFICATION_API_VERSION=latest
PAYMENTS_API_VERSION=latest
STATISTICS_API_VERSION=latest
TRACKER_API_VERSION=latest
WORKOUT_API_VERSION=latest

# Frontend Version
FRONTEND_VERSION=latest

# Third-party Services (Infrastructure)
NGINX_VERSION=1.25-alpine
MONGODB_VERSION=6.0
REDIS_VERSION=7.0-alpine
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
ALERTMANAGER_VERSION=latest

# Registry Prefix (GHCR by default)
REGISTRY_PREFIX=ghcr.io/sport-stride

# Deployment Metadata (Auto-generated)
LAST_DEPLOY_DATE=$(date +%Y-%m-%d)
LAST_DEPLOY_TIME=$(date +%H:%M:%S)
DEPLOYED_BY=github-actions

# Git References (For Traceability)
ACCOUNT_API_GIT_SHA=
