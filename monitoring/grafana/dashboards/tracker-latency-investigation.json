        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(tracker_publish_and_consume_duration_seconds_bucket{phase=\"db_insert_ok\"}[5m])) by (le))",
          "legendFormat": "DB Insert P95",
          "refId": "E"
        },
        {
          "expr": "sum(rate(gin_requests_total{job=\"tracker-api\"}[5m]))",
          "legendFormat": "HTTP req/s",
          "refId": "F"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*(P95)$" },
            "properties": [
              { "id": "unit", "value": "s" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.1 },
                    { "color": "red", "value": 0.5 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*depth$" },
            "properties": [
              { "id": "unit", "value": "short" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 10 },
                    { "color": "red", "value": 50 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "HTTP req/s" },
            "properties": [
              { "id": "unit", "value": "ops" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [{ "color": "blue", "value": null }]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
