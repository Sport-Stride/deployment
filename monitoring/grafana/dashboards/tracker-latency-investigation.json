      "title": "Tracker API — HTTP P95 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gin_request_duration_seconds_bucket{job=\"tracker-api\"}[5m])) by (le))",
          "legendFormat": "tracker-api HTTP P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.5, sum(rate(gin_request_duration_seconds_bucket{job=\"tracker-api\"}[5m])) by (le))",
          "legendFormat": "tracker-api HTTP P50",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
