    {
      "title": "Tracker API — Current Gauges",
      "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "tracker_rabbitmq_queue_depth{queue=\"tracker-events\"}",
          "legendFormat": "tracker-events depth",
          "refId": "A"
        },
        {
          "expr": "tracker_rabbitmq_queue_depth{queue=\"eventsDLQ\"}",
          "legendFormat": "eventsDLQ depth",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(tracker_saga_step_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Saga P95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(tracker_publish_and_consume_duration_seconds_bucket{phase=\"publish_ok\"}[5m])) by (le))",
          "legendFormat": "Publish P95",
